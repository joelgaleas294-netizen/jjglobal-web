{
  "redirects": [
    {
      "source": "/trabaje-con-nosotros.html",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "jjglobal-web.vercel.app"
        }
      ],
      "destination": "https://www.jjglobalsa.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "jjglobal-web-jj-global.vercel.app"
        }
      ],
      "destination": "https://www.jjglobalsa.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "jjglobal-web-git-main-jj-global.vercel.app"
        }
      ],
      "destination": "https://www.jjglobalsa.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "(?<sub>.*)\\.vercel\\.app"
        }
      ],
      "destination": "https://www.jjglobalsa.com/:path*",
      "permanent": true
    }
  ]
}